# Скопировать в .env рядом с этим файлом и заполнить.
# ОБЯЗАТЕЛЬНО: chmod 600 .env — здесь два секрета, каждый даёт полный контроль.

# --- Telegram ---
# Токен от @BotFather.
BOT_TOKEN=
# Твой Telegram ID (узнать у @userinfobot). Несколько — через запятую.
ADMIN_IDS=

# --- Панель 3x-ui ---
# Базовый URL вместе с webBasePath, без завершающего слэша.
# Бот ставится на тот же сервер, что и панель, поэтому 127.0.0.1.
PANEL_BASE_URL=https://127.0.0.1:38443/bCLXgTQFVZ2iXXwyo4
# Токен области admin из раздела «API токены» панели.
PANEL_API_TOKEN=
# У панели самоподписанный сертификат на 127.0.0.1 — проверку выключаем.
# Соединение не выходит за пределы машины, перехватывать его некому.
PANEL_VERIFY_TLS=false

# --- Подписка ---
# Префикс ссылки подписки без subId. Бот добавит /<subId>.
SUB_BASE_URL=https://s.cryptopotok.ru/cdn-4fc733912287

# --- Оплата ---
# Реквизиты одной строкой — бот покажет их покупателю как есть.
PAYMENT_DETAILS=СБП: +7 900 000-00-00 (Банк, Имя О.)

# --- Прочее ---
DB_PATH=/var/lib/shopbot/shop.db
# Через сколько минут неоплаченный заказ считается протухшим.
ORDER_TTL_MINUTES=120
